# arr-control configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=arr-control
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite:////config/arr-control.db

# Polling interval in seconds
POLL_INTERVAL_SECONDS=30
POLL_TIMEOUT_SECONDS=10

# Sonarr Configuration
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key_here
SONARR_TIMEOUT_SECONDS=10
SONARR_VERIFY_TLS=false

# Radarr Configuration
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key_here
RADARR_TIMEOUT_SECONDS=10
RADARR_VERIFY_TLS=false

# qBittorrent Configuration
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_password_here
QBITTORRENT_TIMEOUT_SECONDS=10
QBITTORRENT_VERIFY_TLS=false

# Timezone
TZ=UTC